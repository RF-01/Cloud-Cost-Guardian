# Copy to terraform.tfvars (ignored by Git) and fill in. Never commit terraform.tfvars.

name_prefix = "cg-yourname-"
owner_email = "you@mail.aub.edu"
aws_profile = "guardian"

# Personal stacks: keep these two as they are (CLAUDE.md).
team_stack = false
dry_run    = true

team_email   = "rif07@mail.aub.edu"
sender_email = "rif07@mail.aub.edu"
scan_regions = "all"

# Bedrock (task #15). Defaults are the decided values; uncomment only to override.
# bedrock_model_id           = "us.amazon.nova-2-lite-v1:0"
# bedrock_daily_cap          = 30
# bedrock_max_tokens         = 500
# bedrock_max_question_chars = 500

# At least 16 characters each; generate random values, never reuse real passwords.
# origin_secret: only A-Z a-z 0-9 . _ ~ + / = - (it is an HTTP header value and a systemd env value).
origin_secret      = "CHANGE-ME-origin-secret-32-chars"
dashboard_password = "CHANGE-ME-dashboard-password-32c"
# Dashboard login user (3-32 letters, digits, . _ -). Default below; uncomment only to choose another.
# dashboard_username = "guardian"

# Timing (CONTRACT §8). Defaults are the real values; use minutes for personal / demo stacks, e.g. 300.
timeline_waits = {
  ec2_before_final  = 172800
  ec2_before_action = 86400
  ebs_before_final  = 950400
  ebs_before_action = 259200
}
detection_window_minutes    = 30
eip_stopped_threshold_hours = 24
postpone_seconds            = 604800
